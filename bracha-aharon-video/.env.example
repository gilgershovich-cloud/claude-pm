# Copy to .env.local and fill in. Required for the contact form to store leads.

# Postgres connection string (Neon, Vercel Postgres, etc.).
# For Neon/Vercel use the POOLED connection string.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# TLS to the database. Auto-enabled for non-local hosts; set explicitly to override.
# DATABASE_SSL=true

# Optional email notification on each new lead (via Resend). Leave unset to skip.
# RESEND_API_KEY="re_xxxxxxxx"
# CONTACT_TO="you@example.com"          # defaults to SITE.email
# CONTACT_FROM="leads@yourdomain.com"   # must be a verified Resend sender
